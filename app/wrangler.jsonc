{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── SELF-HOST DEPLOY CONFIG ──────────────────────────────────────
  // This is the REAL, authoritative config now that the app is self-hosted on
  // your own Cloudflare account (no longer generated by Higgsfield's deploy CI).
  // The same file drives local dev (`run-local.sh` / `wrangler dev`, which run
  // in LOCAL mode against a local SQLite mirror) and production (`wrangler
  // deploy`, which uses the real D1 below).
  //
  // Worker name — lowercase + dashes, 3–63 chars. This is the FIRST label of the
  // workers.dev URL: app.<account-subdomain>.workers.dev.
  "name": "app",

  // The Worker entry is the TanStack Start SSR server bundle — `vite build`
  // emits dist/server/server.js (`export default { fetch }`).
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // SSR asset routing: static files in dist/client serve directly (asset-first);
  // any non-asset path — incl. "/" — falls through to the SSR Worker (no
  // index.html ships, so "/" never matches an asset). Do NOT set
  // run_worker_first:true — that makes the Worker intercept /assets/* and 404
  // them (the SSR handler has no asset route).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Public (non-secret) vars. The app needs no secrets — auth is PBKDF2 in D1,
  // sessions are plain cookies. HF_ENV only labels the environment for a demo
  // server function; local dev overrides nothing critical.
  "vars": { "HF_ENV": "production", "APP_SLUG": "soundprofile" },

  // The one piece of infra this app needs: a single D1 (SQLite) database, bound
  // as env.DB. Create it once with `wrangler d1 create soundprofile`, then paste
  // the returned uuid into `database_id` below. In local dev the id is ignored
  // (wrangler uses a local mirror); it is only used for `--remote` / deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soundprofile",
      "database_id": "548dc1ec-46ec-4f83-a77e-6264c0339292",
      "migrations_dir": "migrations"
    }
  ]
}
